# GEMINI_API_KEY: Required for Gemini AI API calls (AI Face Recognition verification).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# AUTH_SECRET: Optional HMAC signing secret for user session tokens.
AUTH_SECRET=""

# Optional Notification Providers (MSG91 SMS, Resend Email, WhatsApp Business Cloud API)
# When configured, finalized absent records dispatch live notifications in addition to logging.
MSG91_AUTH_KEY=""
MSG91_SENDER_ID="UNIATT"
MSG91_TEMPLATE_ID=""

RESEND_API_KEY=""
RESEND_FROM_EMAIL="University Attendance ERP <attendance@university.edu>"

WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Supabase Backend Configuration (Server-Side Sync & Management Reports)
SUPABASE_URL=""
SUPABASE_KEY=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
